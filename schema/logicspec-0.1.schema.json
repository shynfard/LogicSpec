{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://logicspec.dev/schema/logicspec-0.1.schema.json",
  "title": "LogicSpec 0.1",
  "description": "Shape validation for LogicSpec 0.1 documents. Cross-document identity resolution is performed by workspace tooling, not by this schema.",
  "oneOf": [
    { "$ref": "#/definitions/workspaceDocument" },
    { "$ref": "#/definitions/moduleDocument" },
    { "$ref": "#/definitions/featureDocument" },
    { "$ref": "#/definitions/serviceDocument" },
    { "$ref": "#/definitions/eventsDocument" }
  ],
  "definitions": {
    "kebabId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "eventName": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "typeName": {
      "type": "string",
      "description": "Informal type name in v0.1."
    },
    "namedTypeMap": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-zA-Z][a-zA-Z0-9]*$" },
      "additionalProperties": { "$ref": "#/definitions/typeName" }
    },
    "stepTargetMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
      "additionalProperties": { "$ref": "#/definitions/kebabId" }
    },
    "step": {
      "oneOf": [
        { "$ref": "#/definitions/pageStep" },
        { "$ref": "#/definitions/operationStep" },
        { "$ref": "#/definitions/decisionStep" },
        { "$ref": "#/definitions/publishStep" },
        { "$ref": "#/definitions/waitStep" },
        { "$ref": "#/definitions/outcomeStep" }
      ]
    },
    "pageStep": {
      "type": "object",
      "required": ["type", "actions"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "page" },
        "description": { "type": "string" },
        "actions": { "$ref": "#/definitions/stepTargetMap" }
      }
    },
    "operationStep": {
      "type": "object",
      "required": ["type", "call"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "operation" },
        "description": { "type": "string" },
        "call": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "on-success": { "$ref": "#/definitions/kebabId" },
        "on-error": { "$ref": "#/definitions/stepTargetMap" }
      }
    },
    "decisionStep": {
      "type": "object",
      "required": ["type", "when", "branches"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "decision" },
        "description": { "type": "string" },
        "when": { "type": "string" },
        "branches": { "$ref": "#/definitions/stepTargetMap" }
      }
    },
    "publishStep": {
      "type": "object",
      "required": ["type", "event"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "publish" },
        "description": { "type": "string" },
        "event": { "$ref": "#/definitions/eventName" },
        "next": { "$ref": "#/definitions/kebabId" }
      }
    },
    "waitStep": {
      "type": "object",
      "required": ["type", "event"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "wait" },
        "description": { "type": "string" },
        "event": { "$ref": "#/definitions/eventName" },
        "next": { "$ref": "#/definitions/kebabId" },
        "timeout": { "$ref": "#/definitions/kebabId" }
      }
    },
    "outcomeStep": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "outcome" },
        "description": { "type": "string" },
        "result": { "enum": ["success", "failure", "cancelled"] }
      }
    },
    "workspaceDocument": {
      "type": "object",
      "required": ["logicSpec", "kind", "workspace"],
      "additionalProperties": false,
      "properties": {
        "logicSpec": { "const": "0.1" },
        "kind": { "const": "workspace" },
        "workspace": {
          "type": "object",
          "required": ["id", "name"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/definitions/kebabId" },
            "name": { "type": "string" },
            "description": { "type": "string" }
          }
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include": { "type": "array", "items": { "type": "string" } },
            "exclude": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "moduleDocument": {
      "type": "object",
      "required": ["logicSpec", "kind", "module"],
      "additionalProperties": false,
      "properties": {
        "logicSpec": { "const": "0.1" },
        "kind": { "const": "module" },
        "module": {
          "type": "object",
          "required": ["id", "name"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/definitions/kebabId" },
            "name": { "type": "string" },
            "description": { "type": "string" }
          }
        }
      }
    },
    "featureDocument": {
      "type": "object",
      "required": ["logicSpec", "kind", "feature"],
      "additionalProperties": false,
      "properties": {
        "logicSpec": { "const": "0.1" },
        "kind": { "const": "feature" },
        "module": { "$ref": "#/definitions/kebabId" },
        "feature": {
          "type": "object",
          "required": ["id", "name", "start", "steps"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/definitions/kebabId" },
            "name": { "type": "string" },
            "description": { "type": "string" },
            "actors": {
              "type": "array",
              "items": { "$ref": "#/definitions/kebabId" }
            },
            "context": { "$ref": "#/definitions/namedTypeMap" },
            "start": { "$ref": "#/definitions/kebabId" },
            "steps": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
              "additionalProperties": { "$ref": "#/definitions/step" }
            }
          }
        }
      }
    },
    "serviceDocument": {
      "type": "object",
      "required": ["logicSpec", "kind", "service"],
      "additionalProperties": false,
      "properties": {
        "logicSpec": { "const": "0.1" },
        "kind": { "const": "service" },
        "module": { "$ref": "#/definitions/kebabId" },
        "service": {
          "type": "object",
          "required": ["id", "name", "operations"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/definitions/kebabId" },
            "name": { "type": "string" },
            "description": { "type": "string" },
            "operations": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "description": { "type": "string" },
                  "input": { "$ref": "#/definitions/namedTypeMap" },
                  "output": { "$ref": "#/definitions/namedTypeMap" },
                  "errors": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/kebabId" }
                  },
                  "publishes": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/eventName" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "eventsDocument": {
      "type": "object",
      "required": ["logicSpec", "kind", "events"],
      "additionalProperties": false,
      "properties": {
        "logicSpec": { "const": "0.1" },
        "kind": { "const": "events" },
        "module": { "$ref": "#/definitions/kebabId" },
        "events": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Z][A-Za-z0-9]*$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": { "type": "string" },
              "payload": { "$ref": "#/definitions/namedTypeMap" }
            }
          }
        }
      }
    }
  }
}
