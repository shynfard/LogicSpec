{
  "name": "logicspec-vscode",
  "displayName": "LogicSpec",
  "description": "Diagnostics and live Mermaid preview for LogicSpec feature specifications.",
  "version": "0.15.0",
  "private": true,
  "publisher": "Shynfard",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Visualization"
  ],
  "activationEvents": [
    "workspaceContains:**/logicspec.config.yaml",
    "onLanguage:yaml"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "logicspec.previewFeature",
        "title": "LogicSpec: Preview Feature",
        "icon": "$(open-preview)"
      },
      {
        "command": "logicspec.validateWorkspace",
        "title": "LogicSpec: Validate Workspace"
      },
      {
        "command": "logicspec.previewWorkspaceGraph",
        "title": "LogicSpec: Preview Workspace Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "logicspec.startDashboard",
        "title": "LogicSpec: Start Dashboard",
        "icon": "$(globe)"
      },
      {
        "command": "logicspec.openFeatureInDashboard",
        "title": "LogicSpec: Open in Dashboard",
        "icon": "$(globe)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "logicspec",
          "title": "LogicSpec",
          "icon": "$(list-tree)"
        }
      ]
    },
    "views": {
      "logicspec": [
        {
          "id": "logicspecFeatures",
          "name": "Features",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "logicspec.previewFeature",
          "when": "resourceFilename =~ /\\.feature\\.yaml$/",
          "group": "navigation"
        },
        {
          "command": "logicspec.previewWorkspaceGraph",
          "when": "resourceFilename == 'logicspec.config.yaml'",
          "group": "navigation"
        },
        {
          "command": "logicspec.startDashboard",
          "when": "resourceFilename == 'logicspec.config.yaml'",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "logicspec.previewFeature",
          "when": "resourceFilename =~ /\\.feature\\.yaml$/",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "logicspec.previewFeature",
          "when": "resourceFilename =~ /\\.feature\\.yaml$/",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "logicspec.startDashboard",
          "when": "view == logicspecFeatures",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "logicspec.openFeatureInDashboard",
          "when": "view == logicspecFeatures && viewItem == logicspecFeature",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "LogicSpec",
      "properties": {
        "logicspec.preview.view": {
          "type": "string",
          "enum": [
            "interactive",
            "flow",
            "swimlane",
            "sequence",
            "event-model"
          ],
          "default": "interactive",
          "description": "Default preview view. interactive = draggable React Flow canvas; the rest are Mermaid renderings."
        }
      }
    },
    "keybindings": [
      {
        "command": "logicspec.previewFeature",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus && resourceFilename =~ /\\.feature\\.yaml$/"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "^1.90.0",
    "@xyflow/react": "^12.11.2",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "mermaid": "^11.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shynfard/LogicSpec.git"
  },
  "homepage": "https://github.com/shynfard/LogicSpec#readme",
  "bugs": {
    "url": "https://github.com/shynfard/LogicSpec/issues"
  },
  "icon": "media/logo-icon.png",
  "galleryBanner": {
    "color": "#f7f8fa",
    "theme": "light"
  }
}
