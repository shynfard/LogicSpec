{
  "name": "logicspec",
  "version": "0.15.0",
  "description": "A small YAML DSL for describing application feature logic — validate it, visualize it with Mermaid, and use it as a behavioral source of truth for humans and AI coding agents.",
  "keywords": [
    "yaml",
    "dsl",
    "specification",
    "feature",
    "workflow",
    "mermaid",
    "diagram",
    "design",
    "documentation"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "bin": {
    "logicspec": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && vite build --config client/vite.config.ts",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run check:versions && npm run check:docs && npm run build && npm test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client/tsconfig.json",
    "check:versions": "node scripts/check-versions.mjs",
    "check:docs": "node scripts/check-doc-drift.mjs",
    "lint": "biome check src tests scripts client",
    "lint:fix": "biome check --write src tests scripts client",
    "format": "biome format --write src tests scripts client",
    "test": "vitest run && vitest run --config vitest.client.config.ts",
    "test:coverage": "vitest run --coverage && vitest run --config vitest.client.config.ts",
    "test:watch": "vitest",
    "schemas": "npm run build && node scripts/generate-schemas.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^14.0.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@dagrejs/dagre": "^3.1.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.460.0",
    "mermaid": "^11.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shynfard/LogicSpec.git"
  },
  "homepage": "https://github.com/shynfard/LogicSpec#readme",
  "bugs": {
    "url": "https://github.com/shynfard/LogicSpec/issues"
  }
}
