// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`mermaid flowchart renderer > marks normal, error and terminate finals with distinct markers (finalKind) 1`] = `
"flowchart TD
  START(("Start"))
  d{"d<br/>DECISION"}
  done((("done<br/>FINAL · success")))
  failed((("failed<br/>FINAL · failure · ⊗ ERROR")))
  halted((("halted<br/>FINAL · failure · ⦻ TERMINATE")))

  START --> d
  d -- "ok" --> done
  d -- "bad" --> failed
  d -- "stop" --> halted

  classDef error stroke-width:2px,stroke-dasharray:4 3;
"
`;

exports[`mermaid flowchart renderer > renders the booking example deterministically (golden) 1`] = `
"flowchart TD
  START(("Start"))
  select_service["Select Service<br/>PAGE"]
  select_staff["Select Staff<br/>PAGE"]
  select_date["Select Date<br/>PAGE"]
  check_availability[["Check Availability<br/>OPERATION"]]
  select_time["Select Time<br/>PAGE"]
  reserve_slot[["Reserve Slot<br/>OPERATION"]]
  slot_conflict["Slot No Longer Available<br/>ERROR"]:::error
  checkout["Checkout<br/>PAGE"]
  create_payment[["Create Payment<br/>OPERATION"]]
  create_booking[["Confirm Booking<br/>OPERATION"]]
  booking_created>"Booking Created<br/>EVENT"]
  cancel_booking[["Cancel Reservation<br/>OPERATION"]]
  no_slots["No Slots Available<br/>ERROR"]:::error
  availability_error["Availability Error<br/>ERROR"]:::error
  reservation_error["Reservation Error<br/>ERROR"]:::error
  payment_error["Payment Failed<br/>ERROR"]:::error
  booking_error["Booking Error<br/>ERROR"]:::error
  success((("Booking Confirmed<br/>FINAL · success")))
  cancelled((("Booking Cancelled<br/>FINAL · cancelled")))

  START --> select_service
  select_service -- "Select service" --> select_staff
  select_staff -- "select" --> select_date
  select_staff -- "Any Staff" --> select_date
  select_date -- "select" --> check_availability
  check_availability -- "available" --> select_time
  check_availability -- "empty" --> no_slots
  check_availability -- "error" --> availability_error
  select_time -- "select" --> reserve_slot
  select_time -- "back" --> select_date
  reserve_slot -- "success" --> checkout
  reserve_slot -- "conflict" --> slot_conflict
  reserve_slot -- "error" --> reservation_error
  slot_conflict -- "choose-another" --> select_time
  checkout -- "pay" --> create_payment
  checkout -- "cancel" --> cancel_booking
  create_payment -- "success" --> create_booking
  create_payment -- "failure" --> payment_error
  create_booking -- "success" --> booking_created
  create_booking -- "error" --> booking_error
  booking_created --> success
  cancel_booking --> cancelled
  no_slots -- "change-date" --> select_date
  no_slots -- "change-staff" --> select_staff
  availability_error -- "retry" --> check_availability
  reservation_error -- "retry" --> reserve_slot
  payment_error -- "retry" --> create_payment
  payment_error -- "cancel" --> cancel_booking
  booking_error -- "retry" --> create_booking

  classDef error stroke-width:2px,stroke-dasharray:4 3;
"
`;
